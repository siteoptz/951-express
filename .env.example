# Database (Neon via Vercel Marketplace)
DATABASE_URL=
# Direct (unpooled) connection, used by drizzle-kit migrations. Optional: falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Opt-in for the database tests (capacity concurrency). Point at a Neon dev branch, never production.
TEST_DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. 951 Express Bookings <bookings@notify.951express.com>
EMAIL_FROM=
# The dispatcher inbox (comma separated for several). Also the Reply-To on customer emails.
BOOKINGS_EMAIL_TO=

# Admin
ADMIN_PASSWORD=

# Site
# Production: https://951express.com (emails, the dispatch sheet footer and Stripe return links use it)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_ID=

# Phase 4: protects /api/cron/expire-holds
CRON_SECRET=

# Local only: the customer-side address the real-email test (npm run e2e:email) sends to. Use your own inbox.
E2E_EMAIL_CUSTOMER=
